config QEMU_IMX_ROM
	bool
	select BINMAN
	select SUPPORT_SPL
	select ENABLE_ARM_SOC_BOOT0_HOOK
	help
	  Common support for the virtual i.MX boot ROMs for QEMU.

if QEMU_IMX_ROM

config SYS_BOARD
	default "qemu-imx"

config SYS_VENDOR
	default "emulation"

config SYS_CONFIG_NAME
	default "qemu-imx8m-rom" if ARCH_IMX8M
	default "qemu-imx53-rom" if MX53
	default "qemu-imx6-rom" if MX6
	default "qemu-imx7-rom" if MX7

config SPL_LDSCRIPT
	default "board/emulation/qemu-imx/u-boot-spl-imx8m-rom.lds" if ARCH_IMX8M
	default "board/emulation/qemu-imx/u-boot-spl-armv7-rom.lds" if MX53 || MX6 || MX7

endif
